{
    "endpoint": "https://tool.example.com/launch",
    "params": {
        "aud": "characterisation-client",
        "https://purl.imsglobal.org/spec/lti-bo/claim/basicoutcome": {
            "lis_outcome_service_url": "{{wwwroot}}/mod/lti/service.php",
            "lis_result_sourcedid": {
                "data": {
                    "instanceid": "{{instance}}",
                    "typeid": "{{type}}",
                    "userid": "{{user}}"
                }
            }
        },
        "https://purl.imsglobal.org/spec/lti/claim/context": {
            "id": "{{course}}",
            "label": "C1",
            "title": "Course One",
            "type": [
                "CourseSection"
            ]
        },
        "https://purl.imsglobal.org/spec/lti/claim/deployment_id": "{{type}}",
        "https://purl.imsglobal.org/spec/lti/claim/ext": {
            "lms": "moodle-2"
        },
        "https://purl.imsglobal.org/spec/lti/claim/launch_presentation": {
            "document_target": "iframe",
            "locale": "en",
            "return_url": "{{wwwroot}}/mod/lti/return.php?course={{course}}&launch_container=3&instanceid={{instance}}&sesskey={{sesskey}}"
        },
        "https://purl.imsglobal.org/spec/lti/claim/lis": {
            "course_section_sourcedid": "CID1",
