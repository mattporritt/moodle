{{!
    @template tiny_aiplacement/alttext

    AI alt text controls for the Tiny image details dialog.

    Example context (json):
    {
        "idle": true,
        "hasalt": false
    }
}}
{{#idle}}
    <button type="button" class="btn btn-outline-primary mt-2" data-action="generate-alt-text">
        <span class="tiny-aiplacement-sparkles-icon me-1" aria-hidden="true"></span>
        {{#hasalt}}
            {{#str}} alttextreplacewithai, tiny_aiplacement {{/str}}
        {{/hasalt}}
        {{^hasalt}}
            {{#str}} alttextgenerate, tiny_aiplacement {{/str}}
        {{/hasalt}}
    </button>
{{/idle}}
{{#confirm}}
    <div class="alert alert-warning mt-2 mb-0" role="alert">
        <p>{{#str}} alttextreplaceconfirmation, tiny_aiplacement {{/str}}</p>
        <button type="button" class="btn btn-warning btn-sm" data-action="replace-alt-text">
            {{#str}} alttextreplace, tiny_aiplacement {{/str}}
        </button>
        <button type="button" class="btn btn-secondary btn-sm" data-action="keep-alt-text">
            {{#str}} alttextkeep, tiny_aiplacement {{/str}}
        </button>
    </div>
{{/confirm}}
{{#generating}}
    <div class="alert alert-info d-flex align-items-center gap-2 mt-2 mb-0" role="status">
        {{> core/loading }}
        <span>{{#str}} alttextgenerating, tiny_aiplacement {{/str}}</span>
        <button type="button" class="btn btn-link btn-sm p-0 ms-auto" data-action="cancel-alt-text">
            {{#str}} alttextcancel, tiny_aiplacement {{/str}}
        </button>
    </div>
{{/generating}}
{{#success}}
    <div class="alert alert-info mt-2 mb-0" role="status">
        <p>{{#str}} alttextreview, tiny_aiplacement {{/str}}</p>
        <button type="button" class="btn btn-link btn-sm p-0" data-action="regenerate-alt-text">
            {{#str}} alttextregenerate, tiny_aiplacement {{/str}}
        </button>
    </div>
{{/success}}
{{#error}}
    <div class="alert alert-danger mt-2 mb-0" role="alert">
        <p>{{#str}} alttexterror, tiny_aiplacement {{/str}}</p>
        <button type="button" class="btn btn-link btn-sm p-0" data-action="retry-alt-text">
            {{#str}} alttexttryagain, tiny_aiplacement {{/str}}
        </button>
    </div>
{{/error}}
