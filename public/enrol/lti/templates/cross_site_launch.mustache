{{!
    @template enrol_lti/cross_site_launch

    Navigates to a target URL from this (same-site) page, avoiding a cross-site redirect chain.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * url - the URL to navigate to

    Example context (json):
    {
        "url": "https://example.com/course/view.php?id=2"
    }
}}
<a href="{{url}}" id="enrol-lti-launch-continue">{{#str}} continue, moodle {{/str}}</a>

{{#js}}
document.getElementById('enrol-lti-launch-continue').click();
{{/js}}
