{{!
    @template core_comment/comment_list

    Server-side rendered comment list and pagination fragment.
    Loaded via core/fragment when the comment area is opened or paginated.

    Context variables required for this template:
    * cid        - string: unique client ID for the comment area
    * comments   - string: HTML for the rendered comment items (unescaped)
    * pagination - string: HTML for the pagination bar (unescaped)

    Example context (json):
    {
        "cid": "abc123",
        "comments": "<li>...</li>",
        "pagination": ""
    }
}}
<ul id="comment-list-{{cid}}" class="comment-list">
    <li class="first"></li>
    {{{comments}}}
</ul>
{{{pagination}}}
