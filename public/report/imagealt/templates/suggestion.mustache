{{!
    @template report_imagealt/suggestion

    AI alternative text controls for the occurrence review modal.

    Exactly one state key is set at a time. The markup deliberately mirrors tiny_aiplacement/alttext so the same
    workflow looks and behaves identically in the editor's image details dialog and in this report's review modal.

    Context variables required for this template:
    * occurrenceid - The occurrence the generate action applies to.
    * idle - Show the generate/replace button.
    * hasalt - The alternative text field is not empty, so generating would overwrite it.
    * confirm - Show the overwrite confirmation.
    * generating - Show the in-progress state.
    * success - Show the review reminder.
    * canregenerate - A provider can write a description for this image, so the idle and success states offer to.
      Absent on a site with no provider for image descriptions, where a description already written is still shown
      for review but asking for another one cannot work. Every state rendered client-side passes this too, read from
      the region the server rendered it into, so discarding a description cannot leave a generate button behind on a
      site that has no provider to serve it.
    * suggestionid - A stored suggestion that can be discarded, shown alongside the success state.
    * error - Show the failure state.
    * errormessage - A provider-supplied failure message to show instead of the generic one.
    * waiting - Show the queued/processing state for a suggestion being generated in the background.
    * waitingmessage - The sentence describing that background state.

    Example context (json):
    {
        "occurrenceid": 12,
        "idle": true,
        "hasalt": false
    }
}}
{{#idle}}
    {{#canregenerate}}
        <button type="button" class="btn btn-outline-primary mt-2" data-action="report-imagealt-generate"
            data-occurrenceid="{{occurrenceid}}">
            <span class="report-imagealt-sparkles-icon me-1" aria-hidden="true"></span>
            {{#hasalt}}
                {{#str}} alttextreplacewithai, report_imagealt {{/str}}
            {{/hasalt}}
            {{^hasalt}}
                {{#str}} generatealttext, report_imagealt {{/str}}
            {{/hasalt}}
        </button>
    {{/canregenerate}}
{{/idle}}
{{#confirm}}
    <div class="alert alert-warning mt-2 mb-0" role="alert">
        <p>{{#str}} alttextreplaceconfirmation, report_imagealt {{/str}}</p>
        <button type="button" class="btn btn-warning btn-sm" data-action="report-imagealt-replace"
            data-occurrenceid="{{occurrenceid}}">
            {{#str}} alttextreplace, report_imagealt {{/str}}
        </button>
        <button type="button" class="btn btn-secondary btn-sm" data-action="report-imagealt-keep">
            {{#str}} alttextkeep, report_imagealt {{/str}}
        </button>
    </div>
{{/confirm}}
{{#generating}}
    <div class="alert alert-info d-flex align-items-center gap-2 mt-2 mb-0" role="status">
        {{> core/loading }}
        <span>{{#str}} generating, report_imagealt {{/str}}</span>
        <button type="button" class="btn btn-link btn-sm p-0 ms-auto" data-action="report-imagealt-cancel">
            {{#str}} cancel, core {{/str}}
        </button>
    </div>
{{/generating}}
{{#success}}
    <div class="alert alert-info mt-2 mb-0" role="status">
        <p>{{#str}} suggestionready, report_imagealt {{/str}}</p>
        {{#canregenerate}}
            <button type="button" class="btn btn-link btn-sm p-0" data-action="report-imagealt-generate"
                data-occurrenceid="{{occurrenceid}}">
                {{#str}} regenerate, report_imagealt {{/str}}
            </button>
        {{/canregenerate}}
        {{#suggestionid}}
            <button type="button" class="btn btn-link btn-sm p-0 ms-3" data-action="report-imagealt-discard"
                data-suggestionid="{{suggestionid}}">
                {{#str}} discard, report_imagealt {{/str}}
            </button>
        {{/suggestionid}}
    </div>
{{/success}}
{{#error}}
    <div class="alert alert-danger mt-2 mb-0" role="alert">
        <p>
            {{#errormessage}}{{.}}{{/errormessage}}
            {{^errormessage}}{{#str}} alttexterror, report_imagealt {{/str}}{{/errormessage}}
        </p>
        <button type="button" class="btn btn-link btn-sm p-0" data-action="report-imagealt-generate"
            data-occurrenceid="{{occurrenceid}}">
            {{#str}} alttexttryagain, report_imagealt {{/str}}
        </button>
    </div>
{{/error}}
{{#waiting}}
    <div class="alert alert-info mt-2 mb-0" role="status">
        {{waitingmessage}}
    </div>
{{/waiting}}
